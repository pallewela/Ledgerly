{
	"name": "ledgerly",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Ledgerly — calm, local-first personal finance for simpler households. Multi-currency (LKR/USD/AUD), no bank linking.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"papaparse": "^5.4.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.4",
		"@testing-library/svelte": "^5.2.0",
		"@types/node": "^24.0.0",
		"@types/papaparse": "^5.3.15",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.0.0",
		"fake-indexeddb": "^6.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.25.0",
		"svelte-check": "^4.1.5",
		"tailwindcss": "^4.1.4",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0",
		"vite": "^6.2.0",
		"vitest": "^3.1.1"
	}
}
